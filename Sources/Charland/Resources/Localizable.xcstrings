            "value" : "While the lid is open"
          }
        }
      }
    },
    "Finché manca, %@ apre ancora la ricerca di macOS." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Until then, %@ still opens the macOS search."
          }
