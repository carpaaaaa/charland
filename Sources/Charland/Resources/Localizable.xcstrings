            "state" : "translated",
            "value" : "Name"
          }
        }
      }
    },
    "Nome del timer" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timer name"
          }
        }
      }
    },
    "Nomi comuni di app e servizi" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Common app and service names"
          }
        }
      }
    },
    "Nomi di persone, prodotti, sigle: tutto quello che la dettatura deve scrivere esattamente così. Il motore li riconosce già mentre ascolta, anche in mezzo a una frase in italiano: «c'è GPT» diventa «ChatGPT», «test flight» diventa «TestFlight»." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Names of people, products, acronyms: anything dictation must spell exactly this way. The engine picks them up while it listens, even mid-sentence: a misheard “chat G P T” becomes “ChatGPT”, “test flight” becomes “TestFlight”."
          }
        }
      }
    },
    "Non chiudere mai" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Never quit"
          }
        }
      }
    },
    "Non collegato" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not connected"
          }
        }
      }
    },
    "Non ora" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not now"
          }
        }
      }
    },
    "Non raggiungibile, riprovo" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unreachable, retrying"
          }
        }
      }
    },
    "Non risponde" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not responding"
          }
        }
      }
    },
    "Non scelta" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not chosen"
          }
        }
      }
    },
    "Non so" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not sure"
          }
        }
      }
    },
    "Non sono riuscito a scrivere il file." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The file couldn't be written."
          }
        }
      }
    },
    "Non tenerlo più fisso" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unpin"
          }
        }
      }
    },
    "Non trovo la posizione: riprovo fra poco, o scegli una città." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can't find your location: trying again shortly, or choose a city."
          }
        }
      }
    },
    "Non è partita: usa Apri" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Didn't go through: use Open"
          }
        }
      }
    },
    "Non è partito. Controlla la rete e riprova." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It didn't go through. Check your connection and try again."
          }
        }
      }
