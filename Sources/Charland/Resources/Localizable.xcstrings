    },
    "Nel vassoio stanno fino a %lld file non fissati: oltre, escono i più vecchi. I fissati non contano, e la scelta vale subito anche per i file già dentro." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The tray holds up to %lld unpinned files: beyond that, the oldest ones leave. Pinned files don't count, and the choice applies right away to the files already there."
          }
        }
      }
    },
